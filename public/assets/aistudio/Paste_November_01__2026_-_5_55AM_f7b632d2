// HELPER PARA DETECTAR SI TIENE INCIDENCIA O GESTIÓN (EXCLUSIVO PARA EMISIÓN)
function tieneIncidenciaOGestion(c, datos) {
  if (!datos) datos = mapearDatosCliente(c);
  if (!datos) return false;

  // 1. Revisar si la columna Incidencia/Gestión trae texto en el Excel/JSON
  const rawInc = getVal(c, [
    "INCIDENCIA", "INCIDENCIAS", "GESTION", "ULTIMO MOTIVO", 
    "MOTIVO INCIDENCIA", "RESULTADO GESTION", "INCIDENCIA/GESTION"
  ]);
  const valIncidencia = String(rawInc || "").trim();
  const textoUpper = valIncidencia.toUpperCase();

  if (valIncidencia !== "" && 
      !textoUpper.includes("SIN REGISTRO") && 
      !textoUpper.includes("SIN DATO") && 
      !textoUpper.includes("SIN INCIDENCIA") && 
      valIncidencia !== "0") {
    return true; // Ocultar porque ya tiene incidencia
  }

  // 2. Revisar si ya fue gestionada o visitada esta semana
  if (yaSeGestionoEstaSemana(datos.fechaVisita)) {
    return true;
  }

  // 3. Revisar si está pausada o reagendada
  if (c._pausadoHasta || c._volverDia || c._volverFecha) {
    return true;
  }

  return false;
}

// HELPER EXCLUSIVO PARA EMISIÓN (Evalúa la SEMANA COMPLETA de Jueves a Miércoles)
function leTocaCobroEnSemanaActual(c) {
  const datos = mapearDatosCliente(c);
  if (!datos) return false;

  const { inicioJueves, finMiercoles } = obtenerRangoSemanaOperativa();

  const period = (datos.periodicidad || "").toUpperCase();
  const dPago = (datos.diaPago || "").toUpperCase();
  const numeros = (dPago.match(/\d+/g) || []).map(n => parseInt(n, 10));
  const sa = parseInt(datos.sa, 10) || 0;

  // A) SEMANALES: Aplican para trabajar durante la semana en curso
  if (period.includes("SEMANAL")) {
    return true;
  }

  // B) QUINCENALES: Revisa si alguno de los días de cobro cae entre Jueves y Miércoles
  if (period.includes("QUINCENAL")) {
    if (sa >= 14) return true;

    let q1 = 15, q2 = 30;
    if (numeros.length >= 2) {
      q1 = numeros[0];
      q2 = numeros[1];
    } else if (numeros.length === 1) {
      q1 = numeros[0];
      q2 = (q1 + 15) > 30 ? 30 : q1 + 15;
    }

    let cursor = new Date(inicioJueves);
    while (cursor <= finMiercoles) {
      const diaCursor = cursor.getDate();
      const ultimoDiaMes = new Date(cursor.getFullYear(), cursor.getMonth() + 1, 0).getDate();
      let q2Ajustado = q2 > ultimoDiaMes ? ultimoDiaMes : q2;

      if (diaCursor === q1 || diaCursor === q2Ajustado) return true;
      cursor.setDate(cursor.getDate() + 1);
    }
    return false;
  }

  // C) MENSUALES: Revisa si el día del mes cae entre Jueves y Miércoles
  if (period.includes("MENSUAL")) {
    if (sa >= 30) return true;

    let diaCobroOriginal = numeros.length > 0 ? numeros[0] : 1;

    let cursor = new Date(inicioJueves);
    while (cursor <= finMiercoles) {
      const diaCursor = cursor.getDate();
      const ultimoDiaMes = new Date(cursor.getFullYear(), cursor.getMonth() + 1, 0).getDate();
      let diaCobroAjustado = diaCobroOriginal > ultimoDiaMes ? ultimoDiaMes : diaCobroOriginal;

      if (diaCursor === diaCobroAjustado) return true;
      cursor.setDate(cursor.getDate() + 1);
    }
    return false;
  }

  return sa >= 7;
}

// CONTROLADOR PRINCIPAL DE VISTAS DE RUTAS (UNIFICADO)
function cambiarVistaRuta() {
  if (filtroVisualizacionActual === "HOY") {
    ejecutarFiltradoEstrictoPrevio("HOY");
    return;
  } else if (filtroVisualizacionActual === "VENCIDOS") {
    ejecutarFiltradoEstrictoPrevio("PENDIENTE");
    return;
  }

  const modo = document.getElementById("routeSelector").value;
  markerClusterGroup.clearLayers();
  document.getElementById("active-content").innerHTML = "";

  let statsRutaActiva = {
    Semanal: { total: 0, dias: {} },
    Quincenal: { total: 0, dias: {} },
    Mensual: { total: 0, dias: {} },
    Total: 0
  };

  const hoy = new Date();
  const nombreDias = ["DOMINGO", "LUNES", "MARTES", "MIERCOLES", "JUEVES", "VIERNES", "SABADO"];
  const diaNombreHoy = nombreDias[hoy.getDay()];

  // --------------------------------------------------------------------------
  // 1. CASO 🚀 EMISIÓN (Con deduplicación automática)
  // --------------------------------------------------------------------------
  if (modo === "EMISION") {
    let itemsRaw = getLocalServerData("EMISION");
    if (!itemsRaw || itemsRaw.length === 0) {
      itemsRaw = getLocalServerData("B");
    }

    // 🎯 DEDUPLICAR AUTOMÁTICAMENTE POR ID / CONTRATO
    const unicosMap = new Map();
    itemsRaw.forEach(c => {
      const datos = mapearDatosCliente(c);
      if (!datos) return;
      const claveUnica = datos.idEnrutar || datos.contrato || datos.nombre;
      if (claveUnica && !unicosMap.has(claveUnica)) {
        unicosMap.set(claveUnica, c);
      }
    });
    let itemsUnicos = Array.from(unicosMap.values());

    let itemsFiltrados = itemsUnicos.filter((c) => {
      const datos = mapearDatosCliente(c);
      if (!datos) return false;

      // Ocultar únicamente si ya fue visitada o gestionada esta semana
      if (yaSeGestionoEstaSemana(datos.fechaVisita)) {
        return false;
      }

      // Mostrar únicamente si le toca cobro en la semana operativa actual
      return leTocaCobroEnSemanaActual(c);
    });

    sumarStats(itemsFiltrados, statsRutaActiva);
    renderStats(statsRutaActiva, `EMISIÓN - PENDIENTES DE GESTIÓN`);

    let itemsListos = aplicarFiltroPeriodicidad(itemsFiltrados); 
    renderRuta(itemsListos, modo); 
    return;
  }



  // --------------------------------------------------------------------------
  // 2. CASO VISTA RUTA A
  // --------------------------------------------------------------------------
  if (modo === "A") {
    let itemsRaw = getLocalServerData("A");
    let items = itemsRaw.filter((c) => {
      const datos = mapearDatosCliente(c);
      if (!datos) return false;

      if (c._volverDia && String(c._volverDia).toUpperCase().trim() !== diaNombreHoy) {
        return false;
      }

      return esDiaDePagoHoy(c) !== false;
    });

    sumarStats(items, statsRutaActiva);
    renderStats(statsRutaActiva, `RUTA A (HOY / VENCIDOS)`);

    let itemsListos = aplicarFiltroPeriodicidad(items); 
    renderRuta(itemsListos, modo); 
    return;
  }

  // --------------------------------------------------------------------------
  // 3. CASO VER TODAS LAS RUTAS
  // --------------------------------------------------------------------------
  if (modo === "VER_TODAS") {
    const rutasActivas = obtenerRutasSeleccionadas();
    if (rutasActivas.length === 0) {
      renderStats(statsRutaActiva, `NINGUNA RUTA SELECCIONADA`);
      return;
    }

    rutasActivas.forEach((m) => {
      const items = getLocalServerData(m);
      sumarStats(items, statsRutaActiva);
    });

    renderStats(statsRutaActiva, `GENERAL (${rutasActivas.map((r) => "R." + r).join(", ")})`);

    for (const m of rutasActivas) {
      const itemsRaw = getLocalServerData(m);
      let itemsFiltrados = itemsRaw.filter((c) => {
        const datos = mapearDatosCliente(c);
        if (!datos) return false;

        if (m === "A") return esDiaDePagoHoy(c) !== false;

        // Para el resto de rutas en VER TODAS no se ocultan cuentas por gestión/fecha
        return true;
      });
      
      itemsFiltrados = aplicarFiltroPeriodicidad(itemsFiltrados); 
      renderRuta(itemsFiltrados, m);
    }
    return;
  }

  // --------------------------------------------------------------------------
  // 4. CASO RUTAS INDIVIDUALES (B, C, D)
  // --------------------------------------------------------------------------
  if (modo === "FILTRO_ACTIVO") return;

  let itemsRaw = getLocalServerData(modo);
  let items = itemsRaw.filter((c) => {
    const datos = mapearDatosCliente(c);
    if (!datos) return false;

    // Se muestran todas las cuentas activas de la ruta sin ocultar por gestiones o fechas
    return true;
  });

  sumarStats(items, statsRutaActiva);
  renderStats(statsRutaActiva, `RUTA ${modo}`);
  
  let itemsListos = aplicarFiltroPeriodicidad(items); 
  renderRuta(itemsListos, modo); 
}



    function filtrarMapaPorPeriodicidad(periodoSeleccionado, diaSeleccionado = "Todos") {
      filtroPeriodicidadActual = periodoSeleccionado;
      filtroDiaEspecificoActual = diaSeleccionado;

      if (filtroVisualizacionActual !== "HOY" && filtroVisualizacionActual !== "VENCIDOS") {
        filtroVisualizacionActual = "TODOS";
      }
      cambiarVistaRuta();
    }

    function procesarPuntoEnMapa(c, modo, estadoPrecalculado = null) {
      let lat = parseFloat(getVal(c, ["LAT", "LATITUD"]));
      let lon = parseFloat(getVal(c, ["LON", "LONGITUD"]));

      if (isNaN(lat) || isNaN(lon)) {
        let cordsRaw = getVal(c, ["CORDS", "COORDINADAS"]).trim();
        if (cordsRaw && cordsRaw.includes(",")) {
          let partesCords = cordsRaw.split(",");
          lat = parseFloat(partesCords[0]);
          lon = parseFloat(partesCords[1]);
        }
      }

      if (isNaN(lat) || isNaN(lon)) return null;

      const datosCliente = mapearDatosCliente(c);
      if (!datosCliente) return null;

      let dirFinal = getVal(c, ["DIRECCION", "DOMICILIO", "Direccion", "UBICACION"]).toUpperCase();
      if (dirFinal.includes("MAPS.GOOGLE.COM")) {
        let parts = dirFinal.split("q=");
        dirFinal = parts.length > 1 ? decodeURIComponent(parts[1]).toUpperCase() : "VER MAPA";
      }

      const d = {
        ...datosCliente, lat, lon, dirFinal,
        linkWA: obtenerLinkWADinamico(c),
        linkNoEsta: obtenerLinkNoEsta(c),
        estadoHoy: estadoPrecalculado !== null ? estadoPrecalculado : esDiaDePagoHoy(c),
      };

      d.colorBase = obtenerColorPeriodicidad(d.periodicidad);
      let anim = "", borde = "rgba(255,255,255,.8)";

      if (d.estadoHoy === "HOY" || (d.estadoHoy && d.estadoHoy.estado === "HOY")) {
        anim = "es-hoy";
        borde = "#ef4444";
      } else if (d.estadoHoy === "PENDIENTE" || (d.estadoHoy && (d.estadoHoy.estado === "PENDIENTE" || d.estadoHoy.estado === "VENCIDOS"))) {
        anim = "es-vencido";
        borde = "#f59e0b";
      }
      
        // Determinamos la periodicidad en minúsculas y sin acentos
      const periodicidadNorm = (d.periodicidad || "").toLowerCase().normalize("NFD").replace(/[\u0300-\u036f]/g, "");
      const sa = parseInt(d.sa, 10) || 0;
      
      let colorOnda = "#10b981"; // Verde por defecto

      // 1. REGLA SEMANAL
      if (periodicidadNorm.includes("semanal")) {
        if (sa < 8) {
          colorOnda = "#10b981"; // Verde (< 7 días)
        } else if (sa >= 8 && sa <= 60) {
          colorOnda = "#f59e0b"; // Amarillo (7 a 60 días)
        } else if (sa >= 61 && sa <= 180) {
          colorOnda = "#f97316"; // Naranja (61 a 180 días)
        } else if (sa >= 181) {
          colorOnda = "#ef4444"; // Rojo (181 en adelante)
        }
      } 
      // 2. REGLA QUINCENAL
      else if (periodicidadNorm.includes("quincenal")) {
        if (sa < 16) {
          colorOnda = "#10b981"; // Verde (< 15 días)
        } else if (sa >= 16 && sa <= 60) {
          colorOnda = "#f59e0b"; // Amarillo (15 a 60 días)
        } else if (sa >= 61 && sa <= 180) {
          colorOnda = "#f97316"; // Naranja (61 a 180 días)
        } else if (sa >= 181) {
          colorOnda = "#ef4444"; // Rojo (181 en adelante)
        }
      } 
      // 3. REGLA MENSUAL
      else if (periodicidadNorm.includes("mensual")) {
        if (sa < 31) {
          colorOnda = "#10b981"; // Verde (< 30 días)
        } else if (sa >= 31 && sa <= 60) {
          colorOnda = "#f59e0b"; // Amarillo (30 a 60 días)
        } else if (sa >= 61 && sa <= 180) {
          colorOnda = "#f97316"; // Naranja (61 a 180 días)
        } else if (sa >= 181) {
          colorOnda = "#ef4444"; // Rojo (181 en adelante)
        }
      } 
      // CASO GENERAL / OTROS
      else {
        if (sa > 90) colorOnda = "#ef4444";
        else if (sa >= 30) colorOnda = "#f59e0b";
        else colorOnda = "#10b981";
      }

      // 1. Color base del centro del pin según los días sin abonar (sa)
      let colorPinBase = colorOnda; 

      // 2. Color del aro exterior según la FRECUENCIA (Periodicidad)
      let periodicidadNormPin = (d.periodicidad || "").toLowerCase().normalize("NFD").replace(/[\u0300-\u036f]/g, "");
      let colorAroPeriodicidad = "#3b82f6"; // Azul por defecto (Quincenal)

      if (periodicidadNormPin.includes("semanal")) {
        colorAroPeriodicidad = "#0f172a"; // Negro / Oscuro para Semanal
      } else if (periodicidadNormPin.includes("quincenal")) {
        colorAroPeriodicidad = "#3b82f6"; // Azul para Quincenal
      } else if (periodicidadNormPin.includes("mensual")) {
        colorAroPeriodicidad = "#94a3b8"; // Gris claro / Plateado para Mensual
      }

      // 3. Si es hoy o está vencido, activamos el latido, conservando el color del aro por periodicidad (o alerta)
      let colorBordeAro = colorAroPeriodicidad;

      if (d.estadoHoy === "HOY" || (d.estadoHoy && d.estadoHoy.estado === "HOY")) {
        anim = "es-hoy";          // Activa el pulso parpadeante
        colorBordeAro = "#ef4444"; // Rojo vibrante para HOY (destaca sobre la frecuencia)
      } else if (d.estadoHoy === "PENDIENTE" || (d.estadoHoy && (d.estadoHoy.estado === "PENDIENTE" || d.estadoHoy.estado === "VENCIDOS"))) {
        anim = "es-vencido";      
        colorBordeAro = "#f59e0b"; // Ámbar para vencidos
      }

      if (d.ultimoMotivo === "CUENTA NUEVA") {
        iconHtml = `<div class="${anim}" style="display: flex; align-items: center; justify-content: center; width: 20px; height: 20px; background: #fbbf24; clip-path: polygon(50% 0%, 61% 35%, 98% 35%, 68% 57%, 79% 91%, 50% 70%, 21% 91%, 32% 57%, 2% 35%, 39% 35%);"></div>`;
      } else if (modo === "A") {
        iconHtml = `<div class="${anim}" style="background:${colorPinBase}; width:16px; height:16px; border:3px solid ${colorBordeAro}; border-radius:50%;"></div>`;
      } else if (modo === "B") {
        iconHtml = `<div class="${anim}" style="background:${colorPinBase}; width:14px; height:14px; border:3px solid ${colorBordeAro}; border-radius:3px;"></div>`;
      } else if (modo === "C") {
        iconHtml = `<div class="${anim}" style="width:0; height:0; border-left:8px solid transparent; border-right:8px solid transparent; border-bottom:16px solid ${colorPinBase}; filter: drop-shadow(0 0 2px ${colorBordeAro});"></div>`;
      } else if (modo === "D" || modo === "EMISION") {
        iconHtml = `<div class="${anim}" style="background:${colorPinBase}; width:14px; height:14px; transform: rotate(45deg); border:3px solid ${colorBordeAro}; border-radius: 2px;"></div>`;
      } else {
        iconHtml = `<div class="${anim}" style="background:${colorPinBase}; width:12px; height:12px; border:3px solid ${colorBordeAro}; border-radius:50%;"></div>`;
      }


