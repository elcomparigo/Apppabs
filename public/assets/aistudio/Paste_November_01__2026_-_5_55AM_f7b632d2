        marker.dragging.disable();
        map.dragging.enable();
        if (map.tap) map.tap.enable();

        const idAfiliadoServidor = marker.idReal;
        mostrarToast("⏳ Guardando nueva ubicación...", "info");

        const idIframeTemporal = "ifr_tmp_" + Date.now();
        const iframeTemporal = document.createElement("iframe");
