function procesarArchivoImportadoAvanzado(e) {
  const archivo = e.target.files[0];
  if (!archivo) return;
  
  const selector = document.getElementById("routeSelector");
  let val = selector ? selector.value : "A";
  if (val === "VER_TODAS" || val === "FILTRO_ACTIVO") val = "A";

  const lector = new FileReader();
  lector.onload = function(evento) {
    try {
      const jsonImportado = JSON.parse(evento.target.result);
      if (!Array.isArray(jsonImportado)) {
        alert("⚠️ El archivo JSON no es válido (debe contener una lista de registros).");
        return;
      }

      if (tipoImportacionActual === "papelera") {
        let clave = "trash_" + val;
        localStorage.setItem(clave, JSON.stringify(jsonImportado));
        if (window.pabsCacheMemory) window.pabsCacheMemory[clave] = jsonImportado;
        if (typeof mostrarToast === "function") mostrarToast(`✅ Papelera de Ruta ${val} actualizada (${jsonImportado.length} regs)`, "success");
      } else if (tipoImportacionActual === "completa") {
        let clave = "pabs_act_" + val;
        localStorage.setItem(clave, JSON.stringify(jsonImportado));
        if (window.pabsCacheMemory) window.pabsCacheMemory[clave] = jsonImportado;
        if (typeof mostrarToast === "function") mostrarToast(`✅ Ruta ${val} remplazada por completo (${jsonImportado.length} regs)`, "success");
      } else {
        // Fusión inteligente para Pausadas o Reagendadas sin afectar el resto de la ruta
        let rutaActual = getLocalServerData(val);
        
        jsonImportado.forEach(itemImp => {
          let dImp = mapearDatosCliente(itemImp);
          let idx = rutaActual.findIndex(itemAct => {
            let dAct = mapearDatosCliente(itemAct);
            return dAct && dImp && String(dAct.idEnrutar).trim() === String(dImp.idEnrutar).trim();
          });

          if (idx > -1) {
            if (tipoImportacionActual === "pausadas") {
              rutaActual[idx]._pausadoHasta = itemImp._pausadoHasta;
              rutaActual[idx]._motivoPausa = itemImp._motivoPausa;
              rutaActual[idx]._fechaPausa = itemImp._fechaPausa;
            } else if (tipoImportacionActual === "reagendadas") {
              rutaActual[idx]._volverDia = itemImp._volverDia;
            }
          } else {
            rutaActual.push(itemImp);
          }
        });

        saveServerData(val, rutaActual);
        if (typeof mostrarToast === "function") mostrarToast(`✅ ${tipoImportacionActual.toUpperCase()} importadas y fusionadas en Ruta ${val}`, "success");
      }

      cambiarVistaRuta();
      if (typeof actualizarTrashLista === "function") actualizarTrashLista();
    } catch (err) {
      alert("❌ Error al procesar el archivo JSON: " + err.message);
    }
    e.target.value = "";
  };
  lector.readAsText(archivo);
}
