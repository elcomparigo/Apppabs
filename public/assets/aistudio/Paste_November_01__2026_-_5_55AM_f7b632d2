      list.innerHTML = "";
      estadisticasDia.hoyTotal = 0;

      const inyectadosDeAyer = getLocalServerData("pendientes");
      let itemsOrdenados = [...items].sort((a, b) => {
        const datosA = mapearDatosCliente(a);
        const datosB = mapearDatosCliente(b);
        const estadoA = esDiaDePagoHoy(a);
        const estadoB = esDiaDePagoHoy(b);
        const esInyectadoA = inyectadosDeAyer.includes(datosA.idEnrutar) ? 1 : 0;
        const esInyectadoB = inyectadosDeAyer.includes(datosB.idEnrutar) ? 1 : 0;
        if (esInyectadoA !== esInyectadoB) return esInyectadoB - esInyectadoA;
        const esHoyA = estadoA === "HOY" || (estadoA && estadoA.estado === "HOY") ? 1 : 0;
        const esHoyB = estadoB === "HOY" || (estadoB && estadoB.estado === "HOY") ? 1 : 0;
        if (esHoyA !== esHoyB) return esHoyB - esHoyA;
        return datosB.sa - datosA.sa;
      });

      let chunkIndex = 0;
      const chunkSize = 30;

      function renderChunk() {
        const fragment = document.createDocumentFragment();
        const fin = Math.min(chunkIndex + chunkSize, itemsOrdenados.length);

        for (let i = chunkIndex; i < fin; i++) {
          const c = itemsOrdenados[i];
          const datos = procesarPuntoEnMapa(c, modo);
