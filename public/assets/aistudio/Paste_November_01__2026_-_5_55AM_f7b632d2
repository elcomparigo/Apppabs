    function restaurarCuenta(idEnrutarCliente, origen) {
  let keyOrigen = origen === "COBRADA" ? "cobradas_" : "trash_";
  ["A", "B", "C", "D", "EMISION"].forEach((m) => {
    let listaOrigen = getLocalServerData(keyOrigen + m);
    const idx = listaOrigen.findIndex((i) => {
      const d = mapearDatosCliente(i);
      return d && String(d.idEnrutar).trim() === String(idEnrutarCliente).trim();
    });

    if (idx > -1) {
      let item = listaOrigen[idx];
      let modoDestino = item._modoOriginal || m;
