            form.appendChild(input);
          }
        }

        document.body.appendChild(form);
        form.submit();
        document.body.removeChild(form);

        c["LATITUD"] = nuevaLat; c["LONGITUD"] = nuevaLon;
        c["LAT"] = nuevaLat; c["LON"] = nuevaLon;

        let rutaActual = getLocalServerData(modo);
        let idx = rutaActual.findIndex((i) => getVal(i, ["CONTRATO", "ID", "id"]).trim() === marker.idReal);

        if (idx > -1) {
          rutaActual[idx]["LATITUD"] = nuevaLat; rutaActual[idx]["LONGITUD"] = nuevaLon;
          rutaActual[idx]["LAT"] = nuevaLat; rutaActual[idx]["LON"] = nuevaLon;
          saveServerData(modo, rutaActual);
        }

        mostrarToast("✅ Ubicación Sincronizada", "success");
        setTimeout(() => {
          if (iframeTemporal && iframeTemporal.parentNode) iframeTemporal.parentNode.removeChild(iframeTemporal);
        }, 3000);
      });

      marker.on("click", () => {
        if (!marker.dragging.enabled()) {
          abrirBottomSheet(
