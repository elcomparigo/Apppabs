let debounceTimeoutFiltrado;
function filtrar(idContenedor, query) {
  clearTimeout(debounceTimeoutFiltrado);

  debounceTimeoutFiltrado = setTimeout(() => {
    const contenedor = document.getElementById(idContenedor);
    if (!contenedor) return;

    const tarjetas = contenedor.getElementsByClassName("item-lista");
    const busqueda = (query || "").toLowerCase().trim().normalize("NFD").replace(/[\u0300-\u036f]/g, "");

    if (busqueda === "") {
      for (let i = 0; i < tarjetas.length; i++) {
        tarjetas[i].style.display = "";
      }
      return;
    }

    let index = 0;
    const tamanoLote = 100;

    function procesarLoteFiltro() {
      const fin = Math.min(index + tamanoLote, tarjetas.length);

      for (let i = index; i < fin; i++) {
        if (!tarjetas[i].hasAttribute("data-search-text")) {
          tarjetas[i].setAttribute("data-search-text", tarjetas[i].textContent.toLowerCase().normalize("NFD").replace(/[\u0300-\u036f]/g, ""));
        }

        const match = tarjetas[i].getAttribute("data-search-text").includes(busqueda);
        tarjetas[i].style.display = match ? "" : "none";
      }

      index = fin;
      if (index < tarjetas.length) {
        requestAnimationFrame(procesarLoteFiltro);
      }
    }

    requestAnimationFrame(procesarLoteFiltro);
  }, 100);
}

