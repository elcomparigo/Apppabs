      activos.push(item);
      listaOrigen.splice(idx, 1);
      saveServerData(modoDestino, activos);
      saveServerData(keyOrigen + m, listaOrigen);
    }
  });
  cambiarVistaRuta();
  if (typeof actualizarTrashLista === "function") actualizarTrashLista();
}


