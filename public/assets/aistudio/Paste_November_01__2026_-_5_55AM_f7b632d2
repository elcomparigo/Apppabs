async function cambiarEstadoCuenta(idEnrutarCliente, modo, accion) {
  if (!idEnrutarCliente || String(idEnrutarCliente).trim() === "") {
    mostrarToast("⚠️ Error: La cuenta no tiene un ID válido.", "warning");
    return;
  }

  const selectorActual = document.getElementById("routeSelector").value;

  // 1. Determinar EXACTAMENTE qué rutas se permite modificar
  let rutasAEscaneo = [];

  if (selectorActual === "VER_TODAS") {
    // 🎯 REGLA CLAVE: En "VER TODAS" solo escaneamos las rutas que marcaste en Ajustes (ej. A y D)
    rutasAEscaneo = obtenerRutasSeleccionadas(); 
    if (rutasAEscaneo.length === 0) {
      mostrarToast("⚠️ No hay ninguna ruta seleccionada en Ajustes", "warning");
      return;
    }
  } else if (modo && modo !== "VER_TODAS" && modo !== "FILTRO_ACTIVO") {
    // Si la llamada viene de una tarjeta/marcador de una ruta específica
    rutasAEscaneo = [modo];
  } else if (selectorActual && selectorActual !== "FILTRO_ACTIVO") {
    // Si el selector tiene seleccionada una ruta individual (ej: "A")
    rutasAEscaneo = [selectorActual];
  } else {
    rutasAEscaneo = ["A", "B", "C", "D", "EMISION"];
  }

  let cuentaEliminadaAlMenosUnaVez = false;
  let nombreClienteEncontrado = "Cuenta";
  let rutasDondeSeElimino = [];

  // 2. Recorrer ÚNICAMENTE el grupo de rutas autorizadas (ej: A y D)
  for (let r of rutasAEscaneo) {
    let activos = getLocalServerData(r);
    let keyDestino = "trash_" + r;
    let destino = getLocalServerData(keyDestino);

    const idx = activos.findIndex((i) => {
      const d = mapearDatosCliente(i);
      return d && String(d.idEnrutar).trim() === String(idEnrutarCliente).trim();
    });

    if (idx > -1) {
      let item = activos[idx];
      const datosItem = mapearDatosCliente(item);
      if (datosItem && datosItem.nombre) nombreClienteEncontrado = datosItem.nombre;
      
      item._modoOriginal = r;

      // Quitar de activos de la ruta 'r'
      activos.splice(idx, 1);

      // Limpiar caché en memoria para esta ruta específica
      if (window.pabsCacheMemory) {
        window.pabsCacheMemory["pabs_act_" + r] = activos;
      }

      // Mandar a la papelera de la ruta 'r'
      const yaExiste = destino.some(i => {
        const d = mapearDatosCliente(i);
        return d && String(d.idEnrutar).trim() === String(idEnrutarCliente).trim();
      });

      if (!yaExiste) destino.push(item);

      // Remover marcador de Leaflet del mapa
      if (typeof markerClusterGroup !== "undefined" && markerClusterGroup && datosItem) {
        if (item._leafletMarker) {
          markerClusterGroup.removeLayer(item._leafletMarker);
        }
        markerClusterGroup.eachLayer(function (layer) {
          if (layer.idReal && String(layer.idReal).trim() === String(datosItem.idEnrutar).trim()) {
            markerClusterGroup.removeLayer(layer);
          }
        });
      }

      // Guardar cambios en disco/memoria
      await saveServerData(r, activos);
      await saveServerData(keyDestino, destino);

      cuentaEliminadaAlMenosUnaVez = true;
      rutasDondeSeElimino.push(r);

      // Si NO estamos en VER_TODAS, detenemos el proceso tras la primera eliminación
      if (selectorActual !== "VER_TODAS") {
        break;
      }
    }
  }

  if (cuentaEliminadaAlMenosUnaVez) {
    mostrarToast(`🗑️ ${nombreClienteEncontrado} eliminada de: Ruta ${rutasDondeSeElimino.join(", ")}`, "success");
  } else {
    mostrarToast("⚠️ La cuenta no se encontró activa en las rutas seleccionadas", "warning");
  }

  // Refrescar vistas y listas
  cambiarVistaRuta();
  if (typeof actualizarTrashLista === "function") {
    actualizarTrashLista();
  }
}


