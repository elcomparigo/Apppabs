    let debounceTimerBusqueda = null;

function buscarEnMapa(query) {
  clearTimeout(debounceTimerBusqueda);
  
  const texto = (query || "").trim();
  if (texto.length < 2) return; // Se activa a partir de 2 caracteres

  // Aplicamos debounce de 300ms para evitar congelamientos al teclear rápido
  debounceTimerBusqueda = setTimeout(() => {
    const busqueda = texto.toLowerCase().normalize("NFD").replace(/[\u0300-\u036f]/g, "");
    const modoActual = document.getElementById("routeSelector").value;
    
    // Obtener las rutas a escanear según el selector actual
    let rutasAEscaneo = modoActual === "VER_TODAS" ? obtenerRutasSeleccionadas() : [modoActual];
    if (modoActual === "FILTRO_ACTIVO") rutasAEscaneo = ["A", "B", "C", "D", "EMISION"];

    let clienteEncontrado = null;
    let rutaEncontrada = null;

    // Buscar directamente en los datos almacenados (mucho más rápido que recorrer el mapa)
    for (let r of rutasAEscaneo) {
      let items = getLocalServerData(r);
      let match = items.find(c => {
        let d = mapearDatosCliente(c);
        if (!d) return false;
        let idC = String(d.idEnrutar || "").toLowerCase();
        let nomC = (d.nombre || "").toLowerCase().normalize("NFD").replace(/[\u0300-\u036f]/g, "");
        let dirC = (d.dirFinal || "").toLowerCase().normalize("NFD").replace(/[\u0300-\u036f]/g, "");
        
        return idC.includes(busqueda) || nomC.includes(busqueda) || dirC.includes(busqueda);
      });

      if (match) {
        clienteEncontrado = match;
        rutaEncontrada = r;
        break;
      }
    }

    if (clienteEncontrado && clienteEncontrado._leafletMarker) {
      const marker = clienteEncontrado._leafletMarker;
      const datos = mapearDatosCliente(clienteEncontrado);
      
      // Centrar el mapa fluidamente en el marcador encontrado
      map.setView(marker.getLatLng(), 18);
      
      // Abrir directamente el bottom sheet con la información del cliente
      abrirBottomSheet(
        generarContenidoSheet(
          clienteEncontrado, rutaEncontrada, datos.dirFinal, datos.ultimoMotivo, datos.ultimoComentario,
          datos.idEnrutar, datos.idAfiliado, datos.sa, datos.diaPago,
          datos.nombre, datos.linkWA, datos.linkNoEsta, datos.telSolo, esDiaDePagoHoy(clienteEncontrado)
        )
      );

      mostrarToast(`🔍 Encontrado: ${datos.nombre}`, "success");
    } else {
      mostrarToast(`⚠️ No se encontró ninguna coincidencia para "${texto}"`, "warning");
    }
  }, 300);
}


