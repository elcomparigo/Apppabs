function obtenerRangoSemanaOperativa() {
  const hoy = new Date();
  const hoyNorm = new Date(hoy.getFullYear(), hoy.getMonth(), hoy.getDate());
  let diaSemana = hoyNorm.getDay();

  let diasDesdeJueves = (diaSemana >= 4) ? (diaSemana - 4) : (diaSemana + 3);

  let inicioJueves = new Date(hoyNorm);
  inicioJueves.setDate(hoyNorm.getDate() - diasDesdeJueves);

  let finMiercoles = new Date(inicioJueves);
  finMiercoles.setDate(inicioJueves.getDate() + 6);

  return { inicioJueves, finMiercoles, hoyNorm };
}

function obtenerFechaCobroSemanaActual(diaAsignadoTexto) {
  const { inicioJueves } = obtenerRangoSemanaOperativa();
  const diasNombres = ["DOMINGO", "LUNES", "MARTES", "MIERCOLES", "JUEVES", "VIERNES", "SABADO"];
  
  let diaLimpio = String(diaAsignadoTexto || "").toUpperCase().normalize("NFD").replace(/[\u0300-\u036f]/g, "");
  if (diaLimpio.includes("SEMANAL:")) diaLimpio = diaLimpio.split("SEMANAL:")[1].trim();

  let targetDay = diasNombres.indexOf(diaLimpio);
  if (targetDay === -1) return null;

  let cursor = new Date(inicioJueves);
  for (let i = 0; i < 7; i++) {
    if (cursor.getDay() === targetDay) {
      return new Date(cursor.getFullYear(), cursor.getMonth(), cursor.getDate());
    }
    cursor.setDate(cursor.getDate() + 1);
  }
  return null;
}



