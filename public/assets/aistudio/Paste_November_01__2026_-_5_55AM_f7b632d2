        const datos = mapearDatosCliente(c);
        if (!datos || !datos.periodicidad) return;

        let f = datos.periodicidad.normalize("NFD").replace(/[̀-ͯ]/g, "").toUpperCase();
        let dia = (datos.diaPago || "S/D").toUpperCase();

        if (f.includes("SEMANAL")) {
          statsObj.Semanal.total++;
          statsObj.Semanal.dias[dia] = (statsObj.Semanal.dias[dia] || 0) + 1;
        } else if (f.includes("QUINCENAL")) {
          statsObj.Quincenal.total++;
          statsObj.Quincenal.dias[dia] = (statsObj.Quincenal.dias[dia] || 0) + 1;
        } else if (f.includes("MENSUAL")) {
          statsObj.Mensual.total++;
          statsObj.Mensual.dias[dia] = (statsObj.Mensual.dias[dia] || 0) + 1;
        }
        statsObj.Total++;
      });
    }

