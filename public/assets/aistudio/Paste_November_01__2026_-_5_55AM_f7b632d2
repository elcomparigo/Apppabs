function exportarSubCategoria(subtipo) {
  const selector = document.getElementById("routeSelector");
  let val = selector ? selector.value : "A";
  if (val === "VER_TODAS" || val === "FILTRO_ACTIVO") val = "A";
  
  let datos = getLocalServerData(val);
  let filtrados = [];
  let nombreSufijo = "";

  if (subtipo === "completa") {
    filtrados = datos;
    nombreSufijo = "Ruta_" + val + "_Completa";
  } else if (subtipo === "pausadas") {
    filtrados = datos.filter(c => c._pausadoHasta);
    nombreSufijo = "Ruta_" + val + "_Pausadas";
  } else if (subtipo === "reagendadas") {
    filtrados = datos.filter(c => c._volverDia);
    nombreSufijo = "Ruta_" + val + "_Reagendadas";
  } else if (subtipo === "papelera") {
    filtrados = getLocalServerData("trash_" + val);
    nombreSufijo = "Ruta_" + val + "_Papelera";
  }

  const blob = new Blob([JSON.stringify(filtrados, null, 2)], { type: "application/json;charset=utf-8;" });
  const url = URL.createObjectURL(blob);
  const link = document.createElement("a");
  link.href = url;
  link.download = `${nombreSufijo}_${new Date().toISOString().split('T')[0]}.json`;
  document.body.appendChild(link);
  link.click();
  document.body.removeChild(link);
  URL.revokeObjectURL(url);
  
  if (typeof mostrarToast === "function") {
    mostrarToast(`📤 ${nombreSufijo} exportado (${filtrados.length} regs)`, "success");
  }
  toggleMenuExpImp();
}

