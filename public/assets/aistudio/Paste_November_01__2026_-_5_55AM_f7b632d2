let estadoAportacionActivo = false;
const btnAportacion = document.getElementById('btnAportacionReal');
let actualizandoManual = false; 

// 1. Consultar el estado silenciosamente en el servidor
async function checarEstadoEnServidor() {
    if (actualizandoManual) return; 
    
    try {
        const res = await fetch("https://apkrigo.devlara.us.ci/configs.php?id=879&api");
        const data = await res.json();
        
        if(data && data.length > 0) {
            const estadoRealEnBD = data[0].aportacion_real === true || data[0].aportacion_real === 1 || data[0].aportacion_real === "1";
            
            if(estadoAportacionActivo !== estadoRealEnBD) {
                estadoAportacionActivo = estadoRealEnBD;
                actualizarBtnAportacion();
            }
        }
    } catch (error) {
        console.error("Error en la consulta de tiempo real:", error);
    }
}

// 2. Cambiar los colores del botón (Verde = ON, Rojo = OFF)
function actualizarBtnAportacion() {
    if (estadoAportacionActivo) {
        btnAportacion.style.background = "linear-gradient(135deg, #10b981, #059669)";
        btnAportacion.innerHTML = "💰 APORT: ON";
    } else {
        btnAportacion.style.background = "linear-gradient(135deg, #ef4444, #dc2626)";
        btnAportacion.innerHTML = "💰 APORT: OFF";
    }
}

// 3. Al hacer clic, enviar la orden al servidor
async function toggleAportacionReal() {
    actualizandoManual = true; 
    const valorParaServidor = estadoAportacionActivo ? "false" : "true";
    
    estadoAportacionActivo = !estadoAportacionActivo;
    actualizarBtnAportacion();
    mostrarToast("⏳ Guardando cambio...", "info");

    try {
        await fetch(`https://apkrigo.devlara.us.ci/configs.php?id=879&conf=aportacion_real&val=${valorParaServidor}`);
        mostrarToast(`✅ Aportación Real ${estadoAportacionActivo ? 'ACTIVADA' : 'DESACTIVADA'}`, "success");
    } catch(e) {
        estadoAportacionActivo = !estadoAportacionActivo;
        actualizarBtnAportacion();
        mostrarToast("⚠️ Error al guardar", "warning");
    }
    
    actualizandoManual = false; 
}

// 4. Chequeo inicial
checarEstadoEnServidor();

