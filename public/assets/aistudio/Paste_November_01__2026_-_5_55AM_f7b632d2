function gestionarCuentaNueva(itemStr) {
  try {
    const item = JSON.parse(decodeURIComponent(itemStr));
    const idBuscado = String(item.id || "").trim();
    
    let cuentaEncontrada = null;
    let rutaEncontrada = "";

    // Buscamos en las rutas activas (puedes incluir "B" o las que gustes escanear)
    const rutasAEscaneo = ["A", "B", "C", "D", "EMISION"];
    for (let r of rutasAEscaneo) {
      let itemsRuta = getLocalServerData(r);
      let match = itemsRuta.find(c => {
        let d = mapearDatosCliente(c);
        return d && String(d.idEnrutar).trim() === idBuscado;
      });
      if (match) {
        cuentaEncontrada = match;
        rutaEncontrada = r;
        break;
      }
    }

    // Si por alguna razón no está en las rutas locales, la simulamos de emergencia con los datos del semáforo
    if (!cuentaEncontrada) {
      const fullName = `${item.nombre || ""} ${item.paterno || ""} ${item.materno || ""}`.trim().toUpperCase();
