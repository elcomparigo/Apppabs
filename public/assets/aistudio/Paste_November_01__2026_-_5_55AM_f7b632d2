// 2. FUNCIÓN PARA FILTRAR Y DIBUJAR EN EL MAPA
// ==========================================
function filtrarMapaPorEstadistica(tipoFiltro, valorFiltro) {
  // 1. Cerrar el visor de estadísticas
  cerrarVisor();

  const selector = document.getElementById("routeSelector");
  let modo = selector ? selector.value : "B";
  if (modo === "VER_TODAS" || modo === "FILTRO_ACTIVO") modo = "B";

  const datos = getLocalServerData(modo);
  if (!datos || datos.length === 0) return;

  // 2. Limpiar los pines actuales del mapa
  if (typeof markerClusterGroup !== "undefined" && markerClusterGroup) {
    markerClusterGroup.clearLayers();
  }

  // 3. Filtrar las cuentas exactas de la categoría seleccionada
  const filtradas = datos.filter(c => {
    const d = mapearDatosCliente(c);
    if (!d) return false;

    const pLower = (d.periodicidad || "").toLowerCase();
    const sa = parseInt(d.sa, 10) || 0;
    const mot = (d.ultimoMotivo || "").toUpperCase().trim();
    const sys = getVal(c, ["SISTEMA"]).toUpperCase().trim();
    const col = getVal(c, ["COLONIA"]).trim().replace(/^:/, '').toUpperCase();
    const valUpper = (valorFiltro || "").toUpperCase().trim();

    if (tipoFiltro === 'SA_ROJO') return sa > 180;
    if (tipoFiltro === 'SA_NARANJA') return sa > 60 && sa <= 180;
    if (tipoFiltro === 'SA_AMARILLO') return sa >= 8 && sa <= 60;
    if (tipoFiltro === 'SA_VERDE') return sa < 8;
    
    if (tipoFiltro === 'SISTEMA') return sys === valUpper;
    if (tipoFiltro === 'COLONIA') return col === valUpper;
    if (tipoFiltro === 'MOTIVO') return mot === valUpper;
    if (tipoFiltro === 'PERIODICIDAD') return pLower.includes(valUpper.toLowerCase());
    
    return true;
  });

  // 4. Dibujar los marcadores filtrados en el mapa
  filtradas.forEach(c => {
    procesarPuntoEnMapa(c, modo);
  });

  // 5. Renderizar la lista lateral activa
  if (typeof renderRuta === "function") {
    renderRuta(filtradas, modo);
  }

  // 6. Notificación al usuario
  mostrarToast(`📍 Mapa filtrado: ${filtradas.length} cuentas de [${valorFiltro}]`, "info");
}

function formatearFechaConDia(fechaStr) {
  if (!fechaStr || String(fechaStr).trim() === "" || String(fechaStr).toUpperCase().includes("NO REGISTRADA")) {
    return "No registrada";
  }
  

  const fechaLimpia = String(fechaStr).replace(/['"]/g, "").trim();
  

  const partes = fechaLimpia.replace(/-/g, "/").split("/");
  if (partes.length !== 3) return fechaLimpia;

  let anio = parseInt(partes[0], 10);
  let mes = parseInt(partes[1], 10) - 1;
  let dia = parseInt(partes[2], 10);


  if (anio < 1000) {
    let tmp = anio;
    anio = dia;
    dia = tmp;
  }

  const fechaObj = new Date(anio, mes, dia);
  if (isNaN(fechaObj.getTime())) return fechaLimpia;

  const nombreDia = fechaObj.toLocaleDateString("es-MX", { weekday: 'long' });
  const fechaFormateada = `${anio}/${String(mes + 1).padStart(2, '0')}/${String(dia).padStart(2, '0')}`;
  
  return `${nombreDia} ${fechaFormateada}`;
}


