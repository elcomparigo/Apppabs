function procesarReagendadoLocal(idEnrutar, nombre, modo, diaDestino) {
  const mapaDiasCompletos = { L: "LUNES", M: "MARTES", X: "MIERCOLES", J: "JUEVES", V: "VIERNES", S: "SABADO", D: "DOMINGO" };
  const diaNombreDestino = mapaDiasCompletos[diaDestino];
  const rutasABuscar = modo === "VER_TODAS" ? ["A", "B", "C", "D", "EMISION"] : [modo];
  let encontrado = false;

  for (let m of rutasABuscar) {
    let rutaActual = getLocalServerData(m);
    let idx = rutaActual.findIndex((i) => {
      const d = mapearDatosCliente(i);
      return d && String(d.idEnrutar).trim() === String(idEnrutar).trim();
    });

    if (idx > -1) {
      rutaActual[idx]._volverDia = diaNombreDestino;
      const item = rutaActual[idx];
      if (markerClusterGroup) {
        if (item && item._leafletMarker) markerClusterGroup.removeLayer(item._leafletMarker);
        markerClusterGroup.eachLayer(function (layer) {
          if (String(layer.idReal).trim() === String(idEnrutar).trim()) markerClusterGroup.removeLayer(layer);
        });
      }

      const cacheKey = "pabs_act_" + m;
      if (!window.pabsCacheMemory) window.pabsCacheMemory = {};
      window.pabsCacheMemory[cacheKey] = rutaActual;

      const datosLimpios = rutaActual.map(cl => {
        const copia = { ...cl };
        delete copia._leafletMarker;
        return copia;
      });
      localStorage.setItem(cacheKey, JSON.stringify(datosLimpios));

      encontrado = true;
      break;
    }
  }

  if (encontrado) {
    mostrarToast(`📲 Cuenta agendada localmente para el próximo: ${diaNombreDestino}`, "success");
    cerrarBottomSheet();
    setTimeout(() => { cambiarVistaRuta(); }, 250);
  } else {
    mostrarToast(`❌ Error al localizar cuenta`, "warning");
  }
}

