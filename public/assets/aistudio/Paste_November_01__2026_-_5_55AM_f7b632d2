  <script>
    function crearTabla(config) {
      if (!config.length) return null;
      const container = document.getElementById("containertable");
      container.innerHTML = "";
      const table = document.createElement("table");
      table.border = 1;

      const thead = document.createElement("thead");
      const tr = document.createElement("tr");
      ["Etiqueta", "Estado"].forEach(texto => {
        const th = document.createElement("th");
        th.textContent = texto;
        tr.appendChild(th);
      });
      thead.appendChild(tr);
      table.appendChild(thead);
      const tbody = document.createElement("tbody");
      tbody.setAttribute("hx-target", "closest tr");
      tbody.setAttribute("hx-swap", "outerHTML");
      const newjson = config[0];
      const tr1 = document.createElement("tr");
      const tdClave1 = document.createElement("td");
      const button11 = document.createElement("button");
      button11.style.minWidth = "0"; button11.style.width = "150px"; button11.style.padding = "5px 4px"; button11.type = "button";
      button11.classList = "btn btn-info"; button11.textContent = "RESET INFO";
      tdClave1.appendChild(button11);
      const tdValor1 = document.createElement("td");
      const button22 = document.createElement("button");
      button22.style.minWidth = "0"; button22.style.width = "150px"; button22.style.padding = "5px 4px"; button22.type = "button";
      button22.classList = "btn btn-danger"; button22.textContent = "RESET INFO";
      button22.setAttribute('hx-confirm', `¿Seguro?`);
      button22.setAttribute("hx-get", `https://apkrigo.devlara.us.ci/configs.php?conf=enrutar`);
      tdValor1.appendChild(button22);
      tr1.appendChild(tdClave1); tr1.appendChild(tdValor1); tbody.appendChild(tr1);

      Object.entries(newjson).forEach(([clave, valor]) => {
        const tr = document.createElement("tr");
        const tdClave = document.createElement("td");
        const button1 = document.createElement("button");
        button1.style.minWidth = "0"; button1.style.width = "150px"; button1.style.padding = "0 4px"; button1.type = "button";
        button1.classList = "btn btn-info"; button1.textContent = clave;
        tdClave.appendChild(button1);
        const tdValor = document.createElement("td");
        const button2 = document.createElement("button");
        button2.style.minWidth = "0"; button2.style.width = "150px"; button2.style.padding = "0 4px"; button2.type = "button";
        button2.classList = valor ? "btn btn-success" : "btn btn-danger";
        button2.textContent = valor ? "ACTIVADO" : "DESACTIVADO";
        const antivalor = valor ? "false" : "true";
        button2.setAttribute("hx-get", `https://apkrigo.devlara.us.ci/configs.php?id=879&conf=${clave}&val=${antivalor}`);
        tdValor.appendChild(button2);
        tdValor.style.textAlign = "center";
        tr.appendChild(tdClave); tr.appendChild(tdValor); tbody.appendChild(tr);
      });

      table.appendChild(tbody);
      container.appendChild(table);
      htmx.process(table);
      return table;
    }

    async function openconfig() {
      const url = "https://apkrigo.devlara.us.ci/configs.php?id=879&api";
      const response = await fetch(url);
      const data = await response.json();
      crearTabla(data);
    }
  </script>

