function ejecutarProcesoFinal(idCliente, m, nombreCliente, modo) {
  // 1. Determinar en qué ruta exacta está la cuenta
  let rutaAProcesar = modo === "VER_TODAS" ? ["A", "B", "C", "D", "EMISION"] : [modo];
  let cuentaEncontrada = null;
  let rutaRealEncontrada = "";

  for (let r of rutaAProcesar) {
    let itemsRuta = getLocalServerData(r);
    let idx = itemsRuta.findIndex(i => {
      let d = mapearDatosCliente(i);
      return d && String(d.idEnrutar).trim() === String(idCliente).trim();
    });
    if (idx > -1) {
      cuentaEncontrada = itemsRuta[idx];
      rutaRealEncontrada = r;
      break;
    }
  }

  if (!cuentaEncontrada) {
    mostrarToast("⚠️ No se encontró la cuenta en las rutas activas", "warning");
    return;
  }

  let idRealServidor = mapearDatosCliente(cuentaEncontrada).idEnrutar || idCliente;

  const listaMotivos = {
    1: "posible cancelacion",
    3: "Cliente solicita cancelación",
    4: "Domicilio no existe",
    5: "ya no vive en domicilio"
  };
  const textoMotivo = listaMotivos[m] || "";
  
registrarGestionRapida(idRealServidor, textoMotivo, "Cambio de estatus", rutaRealEncontrada);

  // 2. Disparar baliza de imagen anti-CORS hacia el servidor
  const urlIncidencia = `https://webrigo.devlara.us.ci/addinci.php?id=879&afil=${idRealServidor}&dia=&m=${m}&come=${encodeURIComponent(textoMotivo)}`;
  const img = new Image();
  img.src = urlIncidencia;

  // 3. Regla operativa para Jueves y Viernes (Menor carga de trabajo)
  const hoyObj = new Date();
  const diaSemanaHoy = hoyObj.getDay(); // 4 = Jueves, 5 = Viernes
  let fechaPausaDinamica = "";

  if (diaSemanaHoy === 4 || diaSemanaHoy === 5) {
    // Si se gestiona en jueves o viernes, reaparecerá exactamente el mismo día de la próxima semana (+7 días)
    let proximaFecha = new Date(hoyObj);
    proximaFecha.setDate(hoyObj.getDate() + 7);
    const tzOffset = proximaFecha.getTimezoneOffset() * 60000;
    fechaPausaDinamica = new Date(proximaFecha.getTime() - tzOffset).toISOString().split("T")[0];
  } else {
    // Si se gestiona en cualquier otro día, mantiene su cálculo normal por ciclo
    const { finMiercoles } = obtenerRangoSemanaOperativa();
    const tzOffset = finMiercoles.getTimezoneOffset() * 60000;
    const fechaFinPausaOriginal = new Date(finMiercoles.getTime() - tzOffset).toISOString().split("T")[0];

    const datosCliente = mapearDatosCliente(cuentaEncontrada);
    fechaPausaDinamica = calcularProximoPagoDinamico(
        datosCliente.periodicidad, 
        datosCliente.diaPago, 
        fechaFinPausaOriginal
    );
  }

  const fechaHoy = new Date().toLocaleDateString("es-MX", { day: '2-digit', month: '2-digit', year: 'numeric' });

  // Actualizar el objeto directamente
  let rutaActual = getLocalServerData(rutaRealEncontrada);
  let indexReal = rutaActual.findIndex(i => {
    let d = mapearDatosCliente(i);
    return d && String(d.idEnrutar).trim() === String(idRealServidor).trim();
  });

  if (indexReal > -1) {
    rutaActual[indexReal]._pausadoHasta = fechaPausaDinamica;
    rutaActual[indexReal]._motivoPausa = textoMotivo;
    rutaActual[indexReal]._fechaPausa = fechaHoy;
    
    // Guardar una sola vez en memoria, disco y nube
    saveServerData(rutaRealEncontrada, rutaActual);
  }

  mostrarToast(`⏸️ ${nombreCliente} procesado y reagendado para el próximo ${diaSemanaHoy === 4 ? "jueves" : diaSemanaHoy === 5 ? "viernes" : "ciclo"} (${fechaPausaDinamica})`, "warning");
  cerrarBottomSheet();
  cambiarVistaRuta();
}

