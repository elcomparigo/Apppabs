function limpiarAgendaPasada() {
  const hoy = new Date();
  const nombreDias = ["DOMINGO", "LUNES", "MARTES", "MIERCOLES", "JUEVES", "VIERNES", "SABADO"];
  const diaNombreHoy = nombreDias[hoy.getDay()];

  const tzOffset = hoy.getTimezoneOffset() * 60000;
  const hoyStr = new Date(hoy.getTime() - tzOffset).toISOString().split("T")[0];

  ["A", "B", "C", "D", "EMISION"].forEach((m) => {
    let datos = getLocalServerData(m);
    let huboCambio = false;

    datos.forEach((c) => {
      // ⚠️ AQUÍ ESTÁ EL DETALLE:
      if (c._volverDia === diaNombreHoy) { delete c._volverDia; huboCambio = true; }
      if (c._volverFecha) { delete c._volverFecha; huboCambio = true; }
      
      if (c._pausadoHasta && c._pausadoHasta <= hoyStr) {
        delete c._pausadoHasta;
        delete c._motivoPausa;
        huboCambio = true;
      }
    });

    if (huboCambio) {
      saveServerData(m, datos);
    }
  });
}


    function aplicarFiltroPeriodicidad(items) {
      if (filtroPeriodicidadActual === "Todos") return items;
      
      const filtroNorm = filtroPeriodicidadActual.toLowerCase().normalize("NFD").replace(/[\u0300-\u036f]/g, "");
      
      return items.filter(c => {
        const datos = mapearDatosCliente(c);
        if (!datos || !datos.periodicidad) return false;
        
        const p = datos.periodicidad.toLowerCase().normalize("NFD").replace(/[\u0300-\u036f]/g, "");
        const cumpleFrecuencia = p.includes(filtroNorm);
        
        if (!cumpleFrecuencia) return false;
        if (filtroDiaEspecificoActual === "Todos") return true;

        const dPago = (datos.diaPago || "").toUpperCase();
        return dPago.includes(filtroDiaEspecificoActual.toUpperCase());
      });
    }

    function sumarStats(items, statsObj) {
