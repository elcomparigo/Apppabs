  // Ocultar teclado en dispositivos móviles
  input.blur(); 
  
  // Construir la URL de búsqueda
  const urlBusqueda = `https://webrigo.devlara.us.ci/buscar/?buscar=${encodeURIComponent(query)}`;
  
  // Abrir directamente en una nueva pestaña
  window.open(urlBusqueda, '_blank');
  
  // Limpiar el campo de texto
  input.value = ""; 
}
 

